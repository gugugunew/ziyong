{
  // 一键运行 App 到浏览器 / Windows，不再手动输 flutter run -d chrome。
  "version": "0.2.0",
  "configurations": [
    {
      "name": "自用 - Chrome (Release)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "flutterMode": "release"
    },
    {
      "name": "自用 - Chrome",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "chrome"
    },
    {
      "name": "自用 - Edge",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "edge"
    },
    {
      "name": "自用 - Windows",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "windows"
    }
  ]
}
